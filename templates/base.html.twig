<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}My App{% endblock %}</title>

        <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
            }

            .layout {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 250px;
                background: #1f2937;
                color: white;
                padding: 20px;
            }

            .sidebar ul {
                list-style: none;
                padding: 0;
            }

            .sidebar li {
                margin-bottom: 10px;
            }

            .sidebar a {
                color: white;
                text-decoration: none;
            }

            .content {
                flex: 1;
                padding: 30px;
            }
        </style>
    </head>

    <body>

        <div class="layout">

            {% include 'partials/sidebar.html.twig' %}

            <main class="content">
                {% block body %}{% endblock %}
            </main>

        </div>

    </body>
</html>
